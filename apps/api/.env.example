# Postgres — matches docker-compose.yml at the repo root (`npm run db:up`)
DATABASE_URL=postgres://dash:dash@localhost:5432/dash

PORT=4000
NODE_ENV=development

# Comma-separated origins allowed to call the API (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# Per-file upload limit in MB
MAX_UPLOAD_MB=50

# ── GCS warehouse (read-only, powers the /gcs page) ──
# Bucket laid out as <brand>/<marketplace>/<report folder>/<file>.csv
GCS_BUCKET=rb2f-warehouse-dropzone
# Service-account JSON key with "Storage Object Viewer" on the bucket (absolute path, or relative to apps/api)
GCS_CREDENTIALS_FILE=./gcs-service-account.json
# Only this marketplace folder is synced
GCS_MARKETPLACE_FOLDER=amazon
# Re-sync every brand every N minutes (0 = only when you click Sync)
GCS_SYNC_INTERVAL_MIN=0
