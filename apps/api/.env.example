# Postgres — matches docker-compose.yml at the repo root (`bun run db:up`)
DATABASE_URL=postgres://rb2f_admin:MyStrongPass123@localhost:5432/amazon_dashboard

PORT=4000
NODE_ENV=development
# Production (Cloud Run + Cloud SQL) also sets DB_SOCKET_PATH=/cloudsql/<project>:<region>:<instance>/.s.PGSQL.5432

# Per-file upload limit in MB (on Cloud Run a whole request is capped at 32 MiB)
MAX_UPLOAD_MB=50

# ── GCS warehouse (read-only, powers the /gcs page) ──
# Bucket laid out as <brand>/<marketplace>/<report folder>/<file>.csv
GCS_BUCKET=rb2f-warehouse-dropzone
# Local development only: service-account JSON key with "Storage Object Viewer" on the bucket
# (absolute path, or relative to apps/api). On Cloud Run leave it unset — the service account is used.
GCS_CREDENTIALS_FILE=./gcs-service-account.json
# Only this marketplace folder is synced
GCS_MARKETPLACE_FOLDER=amazon
# Blinkit exports live next to Amazon: <brand>/<GCS_BLINKIT_FOLDER>/<folder>/<file>
GCS_BLINKIT_FOLDER=blinkit
# Re-sync every brand (Amazon and Blinkit) every N minutes (0 = only when you click Sync)
GCS_SYNC_INTERVAL_MIN=0

# ── Safeguards (defaults shown) ──
# SYNC_MAX_CONCURRENT=2          brand syncs running at once
# SYNC_COOLDOWN_SEC=120          wait after a sync before "Sync now" works again for that brand
# REINGEST_COOLDOWN_MIN=30       "Re-ingest all" at most once per brand in this window
# INGEST_CONCURRENCY=2           files parsed at once (uploads + syncs)
# RATE_LIMIT_API_PER_MIN=600     API requests per user per minute
# RATE_LIMIT_UPLOADS_PER_10MIN=30
# RATE_LIMIT_SYNC_PER_10MIN=20
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_SEC=300

# ── Blinkit (optional) ──
# Days-of-cover bands for the Inventory view: critical,low,excess (days)
# BK_DOC_BANDS=7,15,45
# Extra label aliases when the SKU mapper and campaign mapper disagree (JSON)
# BK_CATEGORY_ALIASES={"gift box":"Gift Hamper"}
# BK_SKU_ALIASES={"farmers honey":"Harvest Honey"}
